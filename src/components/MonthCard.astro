---
import MonthIllustration from './MonthIllustration.astro';
const {month:m}=Astro.props;
---
<a class="month-card" href={`/months/${m.slug}/`} style={`--month-color:${m.color}`}><div class="month-card-top"><span>{String(m.id).padStart(2,'0')}</span><span>{m.season}</span></div><MonthIllustration month={m} decorative/><div class="month-card-bottom"><h3>{m.zh}</h3><span lang="fr">{m.fr}</span></div></a>
