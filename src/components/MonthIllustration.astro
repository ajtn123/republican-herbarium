---
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
interface Props {
  month: { slug: string; zh: string };
  class?: string;
  decorative?: boolean;
  loading?: 'eager' | 'lazy';
}
const { month, class: className, decorative = false, loading = 'lazy' } = Astro.props;
const assetPath = `/assets/months/${month.slug}.svg`;
const version = createHash('sha256').update(readFileSync(resolve('public', assetPath.slice(1)))).digest('hex').slice(0, 12);
const descriptions: Record<string, string> = {
  vendemiaire: '葡萄串、掌状藤叶与卷须',
  brumaire: '低雾穿过落叶树与远处果园',
  frimaire: '枯枝、卷曲叶片与贴附表面的霜晶',
  nivose: '积雪覆盖的不对称云杉枝与垂挂的球果',
  pluviose: '挂着雨滴的垂柳长叶与池面涟漪',
  ventose: '随长风弯曲的柳枝与飘散的种子',
  germinal: '裂开的种子、初生叶片和向下延伸的根',
  floreal: '野蔷薇盛放的花朵、花蕾与锯齿状复叶',
  prairial: '红三叶草的花球、三出叶与草穗',
  messidor: '三束成熟麦穗、芒针与收束的秸秆',
  thermidor: '暑热下微垂的向日葵、花盘与粗壮枝叶',
  fructidor: '成熟的梨、无花果和剖开的果肉',
};
---
<img
  class:list={['month-illustration', className]}
  src={`${assetPath}?v=${version}`}
  width="360"
  height="360"
  alt={decorative ? '' : `${month.zh}：${descriptions[month.slug]}`}
  loading={loading}
  decoding="async"
/>
