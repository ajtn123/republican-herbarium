---
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { festivalArtwork } from '../lib/festival-art';
import IllustrationImage from './IllustrationImage.astro';
interface Props { slug: string; class?: string; decorative?: boolean; loading?: 'eager' | 'lazy'; defer?: boolean; }
const { slug, class: className, decorative = false, loading = 'lazy', defer = false } = Astro.props;
const art = festivalArtwork[slug];
if (!art) throw new Error(`Unknown complementary-day illustration: ${slug}`);
const assetPath = `/assets/festivals/${slug}.svg`;
const version = createHash('sha256').update(readFileSync(resolve('public', assetPath.slice(1)))).digest('hex').slice(0, 12);
---
<IllustrationImage class:list={['festival-illustration', className]} src={`${assetPath}?v=${version}`} alt={decorative ? '' : art.description} loading={loading} defer={defer}/>
