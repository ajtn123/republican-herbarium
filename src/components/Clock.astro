---
const ticks=Array.from({length:100},(_,i)=>i);
const numerals=Array.from({length:10},(_,i)=>({i,x:200+Math.sin(i*Math.PI/5)*142,y:206-Math.cos(i*Math.PI/5)*142}));
---
<div class="clock-exhibit"><div class="clock-label"><span class="live-dot"></span>巴黎 · 此刻</div><svg id="decimal-clock" class="decimal-clock" viewBox="0 0 400 400" role="img" aria-label="十进制指针时钟，一圈十小时"><circle class="clock-rim" cx="200" cy="200" r="184"/><circle class="clock-rim" cx="200" cy="200" r="176"/>{ticks.map(i=><line class="clock-tick" x1="200" y1={i%10===0?32:27} x2="200" y2={i%10===0?47:33} transform={`rotate(${i*3.6} 200 200)`}/>)}{numerals.map(n=><text x={n.x} y={n.y} class="clock-number" text-anchor="middle">{n.i}</text>)}<text x="200" y="139" class="clock-word" text-anchor="middle">DÉCIMAL</text><text x="200" y="281" class="clock-word" text-anchor="middle">UNE JOURNÉE · DIX HEURES</text><line id="hour-hand" class="hour-hand" x1="200" y1="215" x2="200" y2="115"/><line id="minute-hand" class="minute-hand" x1="200" y1="224" x2="200" y2="74"/><line id="second-hand" class="second-hand" x1="200" y1="230" x2="200" y2="56"/><circle cx="200" cy="200" r="6" fill="var(--ink)"/><circle cx="200" cy="200" r="2" fill="var(--paper)"/></svg><div class="digital-time" id="decimal-time" aria-label="十进制时间">—:—:—</div><div class="clock-bottom"><span>十进制时刻</span><span id="civil-time">正在读取时间</span></div></div>
<script>
import {fromGregorian,roman} from '../lib/calendar';
import data from '../data/client-calendar.json';
const pad=(n:number)=>String(n).padStart(2,'0');
function update(){const d=new Date();const p=Object.fromEntries(new Intl.DateTimeFormat('en-GB',{timeZone:'Europe/Paris',year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',second:'2-digit',hourCycle:'h23'}).formatToParts(d).map(x=>[x.type,x.value]));const seconds=Number(p.hour)*3600+Number(p.minute)*60+Number(p.second)+d.getMilliseconds()/1000;const value=seconds/86400*100000;const h=Math.floor(value/10000),m=Math.floor(value/100)%100,s=Math.floor(value)%100;
 document.querySelector('#decimal-time')!.textContent=`${h}:${pad(m)}:${pad(s)}`;document.querySelector('#civil-time')!.textContent=`民用 ${p.hour}:${p.minute}:${p.second}`;
 for(const [id,angle] of [['hour-hand',value/100000*360],['minute-hand',value/10000%1*360],['second-hand',value/100%1*360]] as const) document.querySelector('#'+id)?.setAttribute('transform',`rotate(${angle} 200 200)`);
 const r=fromGregorian(new Date(Date.UTC(Number(p.year),Number(p.month)-1,Number(p.day))));const date=document.querySelector('#republican-date');if(date)date.textContent=r.festival?`共和 ${roman(r.year)} 年 · ${data.festivals[r.day-1].zh}节`:`共和 ${roman(r.year)} 年 · ${data.months[r.month-1].zh} ${r.day} 日`;
 const today=document.querySelector<HTMLAnchorElement>('#today-link');if(today){if(r.festival){let f=data.festivals[r.day-1];today.textContent=`今日之名：${f.zh}节 ↗`;today.href=`/festivals/${f.slug}/`}else{let v=data.days[r.ordinal];today.textContent=`今日之名：${v.zh} · ${v.fr} ↗`;today.href=`/days/${data.months[r.month-1].slug}-${pad(r.day)}/`}}}
update();setInterval(update,100);
</script>
