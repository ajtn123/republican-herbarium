---
import data from '../data/calendar.json';
---
<section class="converter" aria-labelledby="converter-title"><h2 id="converter-title">在两种日期之间往返</h2><div class="mode-tabs" role="tablist" aria-label="换算方向"><button id="tab-gregorian" role="tab" aria-selected="true" aria-controls="panel-gregorian" data-mode="gregorian">公历 → 共和历</button><button id="tab-republican" role="tab" aria-selected="false" aria-controls="panel-republican" tabindex="-1" data-mode="republican">共和历 → 公历</button></div><form id="panel-gregorian" role="tabpanel" aria-labelledby="tab-gregorian"><label for="gregorian-date">公历日期 <input id="gregorian-date" type="date" min="1792-09-22" max="2100-12-31" value="1792-09-22" required/></label><button class="button" type="submit">换算 <span>→</span></button></form><form id="panel-republican" role="tabpanel" aria-labelledby="tab-republican" hidden><label for="republican-year">共和年 <input id="republican-year" type="number" value="1" min="1" max="309" required style="width:110px"/></label><label for="republican-month">月份 <select id="republican-month">{data.months.map(m=><option value={m.id}>{m.zh}</option>)}<option value="13">补充日</option></select></label><label for="republican-day">日 <input id="republican-day" type="number" value="1" min="1" max="30" required style="width:80px"/></label><button class="button" type="submit">换算 <span>→</span></button></form><output id="converted-date" aria-live="polite">共和 I 年 · 葡月 1 日 · 葡萄</output><p class="converter-note">1792–1805年依历史年首对照；1806年后按“共和年除以4余3置闰”延伸。支持1792-09-22至2100-12-31。<a class="text-link" href="/method/">完整说明 →</a></p><noscript><p>日期交互需要 JavaScript。可直接阅读上方时间划分与换算说明。</p></noscript></section>
<script>
import {fromGregorian,startOfYear,isLeap,roman,DAY_MS} from '../lib/calendar';import data from '../data/calendar.json';
const out=document.querySelector<HTMLOutputElement>('#converted-date')!,gy=document.querySelector<HTMLInputElement>('#gregorian-date')!,ry=document.querySelector<HTMLInputElement>('#republican-year')!,rm=document.querySelector<HTMLSelectElement>('#republican-month')!,rd=document.querySelector<HTMLInputElement>('#republican-day')!;
const describe=(r:ReturnType<typeof fromGregorian>)=>{const v=r.festival?data.festivals[r.day-1]:data.days[r.ordinal];return `共和 ${roman(r.year)} 年 · ${r.festival?'补充日':data.months[r.month-1].zh} ${r.day} 日 · ${v.zh}${r.festival?'节':''}`};
const setMax=()=>{const max=Number(rm.value)===13?(isLeap(Number(ry.value))?6:5):30;rd.max=String(max);if(Number(rd.value)>max)rd.value=String(max)};
ry.addEventListener('input',setMax);rm.addEventListener('change',setMax);
document.querySelector('#panel-gregorian')!.addEventListener('submit',e=>{e.preventDefault();if(!gy.reportValidity())return;const r=fromGregorian(new Date(gy.value+'T00:00:00Z'));out.textContent=describe(r)});
document.querySelector('#panel-republican')!.addEventListener('submit',e=>{e.preventDefault();const form=e.currentTarget as HTMLFormElement;if(!form.reportValidity())return;const d=new Date(startOfYear(Number(ry.value))+((Number(rm.value)-1)*30+Number(rd.value)-1)*DAY_MS);if(d>Date.UTC(2100,11,31)){out.textContent='日期超出支持范围，请选择2100年末以前的日期。';return}out.textContent=`公历 ${d.getUTCFullYear()} 年 ${d.getUTCMonth()+1} 月 ${d.getUTCDate()} 日`});
const tabs=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-mode]'));function activate(t:HTMLButtonElement){for(const b of tabs){const selected=b===t;b.setAttribute('aria-selected',String(selected));b.tabIndex=selected?0:-1;document.querySelector<HTMLElement>('#'+b.getAttribute('aria-controls'))!.hidden=!selected;}out.textContent=t.dataset.mode==='gregorian'?describe(fromGregorian(new Date(gy.value+'T00:00:00Z'))):'输入共和历日期，点击换算。'}
for(const [i,t] of tabs.entries()){t.addEventListener('click',()=>activate(t));t.addEventListener('keydown',e=>{if(['ArrowRight','ArrowLeft','Home','End'].includes(e.key)){e.preventDefault();const target=e.key==='Home'?tabs[0]:e.key==='End'?tabs[1]:tabs[1-i];activate(target);target.focus()}})}
</script>
