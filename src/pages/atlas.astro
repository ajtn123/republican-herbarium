---
import Base from '../layouts/Base.astro';import PageHead from '../components/PageHead.astro';import data from '../data/calendar.json';
---
<Base title="每日图谱" section="atlas"><div class="container"><PageHead title="每一天，都有一个物象。" subtitle="从葡萄到篮子，逐一认识田野、林地、水域与工坊里的名字。" eyebrow="LE CALENDRIER RURAL"/><form class="filters" role="search" id="atlas-filters"><label for="atlas-query">名称 <input id="atlas-query" type="search" placeholder="搜索中文或法文…"/></label><label for="atlas-month">月份 <select id="atlas-month"><option value="">全部月份</option>{data.months.map(m=><option value={m.id}>{m.zh} · {m.fr}</option>)}</select></label><label for="atlas-category">类别 <select id="atlas-category"><option value="">全部类别</option>{['植物与产物','动物','大地材料','器物'].map(c=><option>{c}</option>)}</select></label><button type="reset" class="text-link">重置 ↺</button></form><p class="atlas-counter" id="atlas-count" aria-live="polite">共 360 个普通日名</p><p class="empty-result" id="atlas-empty" hidden>没有匹配的日名。试试法文原名，或重置筛选。</p>{data.months.map(m=><section class="atlas-month" data-month={m.id} style={`--accent:${m.color}`}><h2><a href={`/months/${m.slug}/`}>{m.zh}<span>{m.fr} </span></a></h2><div class="day-grid">{data.days.filter(d=>d.month===m.id).map(d=><a href={`/days/${d.slug}/`} class="day-cell" data-cat={d.category} data-name={`${d.zh} ${d.fr}`}><span class="day-num">{String(d.day).padStart(2,'0')}</span><h3>{d.zh}</h3><span class="fr" lang="fr">{d.fr}</span></a>)}</div></section>)}<section style="padding:30px 0"><div class="section-heading"><h2>月份以外，公民的节日</h2><a href="/festivals/">读补充日的设计 →</a></div>{data.festivals.map((f,i)=><a class="festivals-row" href={`/festivals/${f.slug}/`}><span>{String(i+1).padStart(2,'0')}</span><h3>{f.zh}节</h3><p>{f.subtitle}</p></a>)}</section></div><script>
 const form=document.querySelector<HTMLFormElement>('#atlas-filters')!;const q=document.querySelector<HTMLInputElement>('#atlas-query')!,m=document.querySelector<HTMLSelectElement>('#atlas-month')!,c=document.querySelector<HTMLSelectElement>('#atlas-category')!;
 const norm=(s:string)=>s.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
 const filter=()=>{let n=0;document.querySelectorAll<HTMLElement>('.atlas-month').forEach(section=>{let visible=0;section.querySelectorAll<HTMLElement>('.day-cell').forEach(a=>{let show=(!m.value||m.value===section.dataset.month)&&(!c.value||c.value===a.dataset.cat)&&norm(a.dataset.name!).includes(norm(q.value.trim()));a.hidden=!show;if(show)visible++});section.hidden=!visible;n+=visible});document.querySelector('#atlas-count')!.textContent=`显示 ${n} / 360 个普通日名`;document.querySelector<HTMLElement>('#atlas-empty')!.hidden=n>0};
 form.addEventListener('submit',e=>e.preventDefault());form.addEventListener('input',filter);form.addEventListener('reset',()=>setTimeout(filter,0));
</script></Base>
