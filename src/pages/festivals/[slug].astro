---
import Base from '../../layouts/Base.astro';import data from '../../data/calendar.json';
export function getStaticPaths(){return data.festivals.map((festival,index)=>({params:{slug:festival.slug},props:{festival,index}}))}
const {festival:f,index:i}=Astro.props;const numbers=['I','II','III','IV','V','VI'];const colors=['#6a7857','#687d8c','#a37143','#8b6d86','#9d7e35','#a2563d'];
---
<Base title={`${f.zh}节 · ${f.fr}`} description={f.identity} accent={colors[i]}><div class="container"><div class="breadcrumb"><a href="/festivals/">年终补充日</a> / {i+1}</div><article><header class="festival-cover"><p class="eyebrow">{i===5?'闰年独有 · 第六补充日':`第 ${i+1} 补充日`}</p><div class="festival-roman" aria-hidden="true">{numbers[i]}</div><h1>{f.zh}节</h1><p class="subtitle">{f.subtitle}</p></header><div class="festival-essay"><p class="root-line" lang="fr">{['Fête de la Vertu','Fête du Génie','Fête du Travail','Fête de l’Opinion','Fête des Récompenses','Fête de la Révolution'][i]}</p><p>{f.identity}</p><p>{f.story}</p><p class="converter-note">关于节庆方案与历史实施的差别，参见 <a class="text-link" href="/sources/">资料与译名 →</a>。</p></div></article><nav class="page-pagination" aria-label="节日顺序"><a href={i===0?'/days/fructidor-30/':`/festivals/${data.festivals[i-1].slug}/`}>← {i===0?'篮子':data.festivals[i-1].zh+'节'}</a><a href="/festivals/">补充日总览</a><a href={i===5?'/months/vendemiaire/':`/festivals/${data.festivals[i+1].slug}/`}>{i===5?'新年的葡月':data.festivals[i+1].zh+'节'} →</a></nav></div></Base>
