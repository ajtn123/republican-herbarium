---
import Base from '../../layouts/Base.astro';import DayNavigation from '../../components/DayNavigation.astro';import Specimen from '../../components/Specimen.astro';import data from '../../data/calendar.json';
export function getStaticPaths(){return data.days.map(day=>({params:{slug:day.slug},props:{day}}))}
const {day:d}=Astro.props;const m=data.months[d.month-1];
let kind=d.zh==='葡萄'?'grape':d.category==='大地材料'?'mineral':d.category==='器物'?'tool':d.category==='动物'?'animal':/麦|黍|粱|亚麻|草籽|荞|谷子/.test(d.zh)?'grain':/树|杨|柳|杉|榆|松|柏|桦|橡/.test(d.zh)?'tree':/果|苹果|梨|桃|瓜|葡萄|莓|栗|柠檬|石榴|榛子|核桃|李子/.test(d.zh)?'fruit':'flower';
let related=data.days.filter(x=>x.category===d.category&&x.month!==d.month&&x.id!==d.id-1&&x.id!==d.id+1);if(!related.length)related=data.days.filter(x=>x.category===d.category&&x.id!==d.id&&x.id!==d.id-1&&x.id!==d.id+1);const picks=[related[(d.id*3)%related.length],related[(d.id*3+17)%related.length],related[(d.id*3+31)%related.length]];
---
<Base title={`${d.zh} · ${m.zh}${d.day}日`} description={d.identity} accent={m.color} section="atlas"><div class="container"><div class="breadcrumb"><a href="/atlas/">每日图谱</a> / <a href={`/months/${m.slug}/`}>{m.zh}</a> / {d.day}</div><article class={`essay-layout essay-${kind}`}><aside class="essay-cover" aria-label="装饰性形态意象"><span class="day-large" aria-hidden="true">{String(d.day).padStart(2,'0')}</span><Specimen kind={kind} seed={d.id} label="类别形态示意，非本物象的鉴定图"/><p class="plate-note">图形为类别意象，非物种鉴定图。</p></aside><div class="essay-body"><p class="eyebrow">{m.fr.toUpperCase()} · 第 {d.decade} 旬 · {d.weekday}</p><h1>{d.zh}</h1><p class="foreign-title" lang="fr">{d.fr}</p><div class="essay-meta"><a href={`/months/${m.slug}/`}>{m.zh} {d.day} 日 </a><span>{d.category}</span><span>全年第 {d.id} 个普通日</span></div><h2>{d.category==='器物'?'器形与动作':d.category==='大地材料'?'材料与性质':d.category==='动物'?'生命与生境':'看见这个名字'}</h2><p>{d.identity}</p><h2>{d.category==='器物'?'劳动留下的形状':d.category==='大地材料'?'大地与人的历史':d.category==='动物'?'人类世界中的回声':'从自然走向文化'}</h2><p class="essay-story">{d.story}</p><p class="source-ref">日名依据：<a href="https://cris23.fr/nom_jours_repub.htm" target="_blank" rel="noopener noreferrer">农村历日名对照表 </a>。<a href="/sources/">查看译名与资料处理</a>。</p></div></article><DayNavigation currentHref={`/days/${d.slug}/`}/><section class="related"><h2 style="margin-top:35px">循着{d.category==='植物与产物'?'自然':d.category}继续读</h2><div class="related-links">{picks.map(x=><a href={`/days/${x.slug}/`}>{x.zh} <span>{data.months[x.month-1].zh} {x.day} 日 · {x.fr}</span></a>)}</div></section></div></Base>
