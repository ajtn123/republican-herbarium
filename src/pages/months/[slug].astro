---
import Base from '../../layouts/Base.astro';import Specimen from '../../components/Specimen.astro';import data from '../../data/calendar.json';
export function getStaticPaths(){return data.months.map(month=>({params:{slug:month.slug},props:{month}}))}
const {month:m}=Astro.props;const entries=data.days.filter(d=>d.month===m.id);const previous=data.months[(m.id+10)%12],next=data.months[m.id%12];const kinds=['grape','tree','tree','mineral','flower','flower','flower','flower','grain','grain','flower','fruit'];
---
<Base title={`${m.zh} · ${m.fr}`} description={m.desc} accent={m.color} section="months"><div class="container"><div class="breadcrumb"><a href="/months/">十二个月</a> / {String(m.id).padStart(2,'0')}</div><section class="month-hero"><div class="page-head"><p class="eyebrow">{m.season} · 第 {m.id} 月</p><h1>{m.zh}<span lang="fr">{m.fr}</span></h1><p class="subtitle">{m.subtitle}</p></div><div class="month-visual"><span class="hero-number" aria-hidden="true">{String(m.id).padStart(2,'0')}</span><Specimen kind={kinds[m.id-1]} seed={m.id} label={`${m.zh}的季节意象示意`}/></div></section><div class="editorial-pair"><section><h2>名字与意象</h2><p class="root-line">{m.root}</p><p>{m.desc}</p></section><section><h2>历史在这里留下回声</h2><p>{m.story}</p></section></div><section class="day-list" aria-label="本月三十个日名">{[1,2,3].map(n=><><div class="decade-title"><h3>第 {n} 旬</h3><span>{(n-1)*10+1} — {n*10}</span></div><div class="day-grid">{entries.slice((n-1)*10,n*10).map(d=><a href={`/days/${d.slug}/`} class="day-cell" data-cat={d.category}><span class="day-num">{String(d.day).padStart(2,'0')}</span><h3>{d.zh}</h3><span class="fr" lang="fr">{d.fr}</span></a>)}</div></>)}</section><nav class="page-pagination" aria-label="相邻月份"><a href={`/months/${previous.slug}/`}>← {previous.zh}</a><a href="/atlas/">按名称与类别检索</a><a href={m.id===12?'/festivals/':`/months/${next.slug}/`}>{m.id===12?'补充日':next.zh} →</a></nav><p class="converter-note" style="padding:25px 0">本月日名依通行的1793年农村历表编排。译名和异文处理见 <a class="text-link" href="/sources/">资料与译名 →</a>。</p></div></Base>
